# RMQR Environment Variables Example
# Copy this file to .env.local and fill in your credentials.
# Never commit real secrets to version control.

# Application URL (used for generating dynamic QR redirect URLs, landing page URLs, and menu URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session signing secret (for server-side HTTP-only session cookies)
RMQR_SESSION_SECRET=

# Supabase Configuration (Optional in local dev — falls back to persistent local server DB if omitted)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Agent QR & OCR Integration (Server-side only — never exposed to client)
# Supported AI_PROVIDER values: gemini (default) | openai
# When AI_API_KEY (or GEMINI_API_KEY / OPENAI_API_KEY) is omitted, AI Agent QR operates transparently in Grounded Knowledge Retrieval Mode.
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash
AI_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Google Business Profile OAuth (Optional — enables direct GBP review sync when set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Payment Providers (Optional — enables live Stripe or Razorpay checkout sessions when set)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
