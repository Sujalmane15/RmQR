# RMQR Environment Variables Example
# Copy this file to .env.local and fill in your credentials.
# Never commit real secrets to version control.

# Application URL (used for generating dynamic QR redirect URLs, landing page URLs, and menu URLs)
# On Vercel production, set this to your HTTPS domain (e.g. https://your-project.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session signing secret (for server-side HTTP-only session cookies and signed review tokens)
# Generate a 64-character random hex secret in PowerShell
RMQR_SESSION_SECRET=

# Supabase PostgreSQL Configuration
# Server-side credentials (Recommended for Vercel + Next.js App Router API routes):
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
# SERVER-ONLY: Never expose SUPABASE_SERVICE_ROLE_KEY in NEXT_PUBLIC_* or browser code
SUPABASE_SERVICE_ROLE_KEY=

# Optional public browser Supabase variables (only if browser-side Supabase SDK is used):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Gemini API & AI Integration (SERVER-ONLY — never use NEXT_PUBLIC_GEMINI_API_KEY)
# Supported AI_PROVIDER values: gemini (default) | openai
# Default model: gemini-2.5-flash
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
AI_API_KEY=
OPENAI_API_KEY=

# Optional local JSON fallback path override (used only in local development when Supabase is not configured)
RMQR_DB_PATH=

# Google Business Profile OAuth (Optional — enables direct GBP review sync when set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Payment Providers (Optional — enables live Stripe or Razorpay checkout sessions when set)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
